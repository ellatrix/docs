{
	"core": "WordPress/WordPress#6.9-branch",
	"plugins": [
		"https://github.com/WordPress/gutenberg/releases/download/v22.9.0-rc.1/gutenberg.zip",
		"."
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run tests-cli -- wp user update 1 --user_email=ellatrix@chat.wordpress.org --display_name=Ella --skip-email"
	},
	"port": 2025,
	"testsPort": 2026,
	"env": {
		"tests": {
			"mappings": {
				"wp-content/mu-plugins/mail-capture.php": "./tests/e2e/mu-plugins/mail-capture.php"
			}
		}
	}
}
